                    }
                },
                "limit": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "handlers.UsersPage": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
